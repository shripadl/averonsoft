{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@payframe/*": ["./uk-tax-calculator/*"],
      "@areamap/*": ["./area-map/*"],
      "@homedecor/*": ["./home-decor/*"],
      "@satbara/*": ["./satbara/*"],
      "@passphoto/*": ["./passport-photo/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "uk-tax-calculator/node_modules",
    "uk-tax-calculator/.next",
    "uk-tax-calculator/app",
    "uk-tax-calculator/vitest.config.mts",
    "uk-tax-calculator/next.config.ts",
    "uk-tax-calculator/next-env.d.ts",
    "uk-tax-calculator/lib/**/__tests__",
    "area-map/node_modules",
    "area-map/.next",
    "area-map/app",
    "area-map/next.config.ts",
    "area-map/next-env.d.ts",
    "home-decor/node_modules",
    "home-decor/.next",
    "home-decor/app",
    "home-decor/next.config.ts",
    "home-decor/next-env.d.ts",
    "satbara/node_modules",
    "satbara/.next",
    "satbara/app",
    "satbara/next.config.ts",
    "satbara/next-env.d.ts",
    "passport-photo/node_modules",
    "passport-photo/.next",
    "passport-photo/app",
    "passport-photo/next.config.ts",
    "passport-photo/next-env.d.ts"
  ]
}
