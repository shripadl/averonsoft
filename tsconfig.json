{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@payframe/*": ["./uk-tax-calculator/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "uk-tax-calculator/node_modules",
    "uk-tax-calculator/.next",
    "uk-tax-calculator/app",
    "uk-tax-calculator/vitest.config.mts",
    "uk-tax-calculator/next.config.ts",
    "uk-tax-calculator/next-env.d.ts",
    "uk-tax-calculator/lib/**/__tests__"
  ]
}
